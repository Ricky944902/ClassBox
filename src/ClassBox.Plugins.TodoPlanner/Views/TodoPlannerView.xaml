<UserControl x:Class="ClassBox.Plugins.TodoPlanner.Views.TodoPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="待办清单" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock x:Name="HeaderHint"
                       Text="新增、勾选、编辑本地待办；数据保存在插件数据目录的 todos.json。"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 录入区 -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="16,14,16,14" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="0" Height="34"
                         Style="{DynamicResource FluentTextBoxStyle}" Padding="12,0"
                         VerticalContentAlignment="Center"
                         TextChanged="OnInputChanged"
                         ToolTip="待办标题" />

                <ComboBox x:Name="PriorityBox" Grid.Row="0" Grid.Column="1" Width="96" Height="34"
                          Margin="10,0,0,0" Style="{DynamicResource FluentComboBoxStyle}"
                          SelectedIndex="1" />

                <DatePicker x:Name="DueDatePicker" Grid.Row="0" Grid.Column="2" Width="140" Height="34"
                            Margin="10,0,0,0"
                            Background="{DynamicResource AppLayerBrush}"
                            Foreground="{DynamicResource AppTextPrimaryBrush}"
                            BorderBrush="{DynamicResource AppStrokeBrush}" />

                <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TagsBox" Grid.Column="0" Height="34"
                             Style="{DynamicResource FluentTextBoxStyle}" Padding="12,0"
                             VerticalContentAlignment="Center"
                             TextChanged="OnInputChanged"
                             ToolTip="标签，多个用逗号分隔，例如：工作,紧急" />
                    <TextBox x:Name="NotesBox" Grid.Column="1" Width="240" Height="34" Margin="10,0,0,0"
                             Style="{DynamicResource FluentTextBoxStyle}" Padding="12,0"
                             VerticalContentAlignment="Center"
                             TextChanged="OnInputChanged"
                             ToolTip="备注（可选）" />
                </Grid>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="AddButton" Content="添加待办" MinWidth="104"
                            Style="{DynamicResource FluentButtonStyle}" Click="OnAddOrSaveClick" />
                    <Button x:Name="CancelEditButton" Content="取消编辑" MinWidth="88" Margin="10,0,0,0"
                            Style="{DynamicResource SubtleButtonStyle}" Click="OnCancelEditClick" IsEnabled="False" />
                    <Button x:Name="ClearFormButton" Content="清空输入" MinWidth="88" Margin="10,0,0,0"
                            Style="{DynamicResource SubtleButtonStyle}" Click="OnClearFormClick" />
                    <TextBlock x:Name="FormHint" VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" Text="标题为必填项" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 筛选区 -->
        <Border Grid.Row="2" Style="{DynamicResource SubtleCardStyle}" Padding="14,10,14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="StatusBox" Grid.Column="0" Width="112" Height="34"
                          Style="{DynamicResource FluentComboBoxStyle}"
                          SelectionChanged="OnFilterChanged" />
                <ComboBox x:Name="PriorityFilterBox" Grid.Column="1" Width="112" Height="34" Margin="8,0,0,0"
                          Style="{DynamicResource FluentComboBoxStyle}"
                          SelectionChanged="OnFilterChanged" />
                <ComboBox x:Name="SortBox" Grid.Column="2" Width="128" Height="34" Margin="8,0,0,0"
                          Style="{DynamicResource FluentComboBoxStyle}"
                          SelectionChanged="OnFilterChanged" />

                <TextBox x:Name="SearchBox" Grid.Column="3" Height="34" Margin="8,0,0,0"
                         Style="{DynamicResource FluentTextBoxStyle}" Padding="12,0"
                         VerticalContentAlignment="Center"
                         TextChanged="OnFilterChanged"
                         ToolTip="按标题 / 备注 / 标签搜索" />

                <Button x:Name="DeleteSelectedButton" Grid.Column="4" Content="删除选中" MinWidth="90"
                        Height="34" Margin="8,0,0,0"
                        Style="{DynamicResource SubtleButtonStyle}" Click="OnDeleteSelectedClick" />
                <Button x:Name="ClearCompletedButton" Grid.Column="5" Content="清空已完成" MinWidth="100"
                        Height="34" Margin="8,0,0,0"
                        Style="{DynamicResource SubtleButtonStyle}" Click="OnClearCompletedClick" />
            </Grid>
        </Border>

        <!-- 列表 -->
        <Border Grid.Row="3" Style="{DynamicResource CardStyle}" Padding="8,8,8,8">
            <Grid>
                <ListBox x:Name="TodoList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{DynamicResource FluentListBoxItemStyle}"
                         SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource AppLayerBrush}" CornerRadius="8"
                                    Padding="12,10,12,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                              Style="{DynamicResource FluentCheckBoxStyle}"
                                              IsChecked="{Binding IsDone, Mode=TwoWay}"
                                              Click="OnItemCheckClick" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource AppTextSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border CornerRadius="4" Padding="6,1,6,1"
                                                    Background="{DynamicResource AppSelectedBrush}">
                                                <TextBlock FontSize="11" Text="{Binding PriorityText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource AppTextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PriorityText}" Value="高">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource AppDangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PriorityText}" Value="中">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource AppWarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                       Text="{Binding DueDateText}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource AppTextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource AppDangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                       Text="{Binding TagsText}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                       Text="{Binding StateText}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="编辑" Width="52" Height="28" Margin="6,0,0,0"
                                                Style="{DynamicResource SubtleButtonStyle}"
                                                Click="OnEditItemClick" />
                                        <Button Content="删除" Width="52" Height="28" Margin="6,0,0,0"
                                                Style="{DynamicResource SubtleButtonStyle}"
                                                Click="OnDeleteItemClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyHint" Text="暂无待办，先在上方添加一条吧。"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           IsHitTestVisible="False" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- 统计 -->
        <TextBlock x:Name="StatsText" Grid.Row="4" Margin="2,10,0,0"
                   Foreground="{DynamicResource AppTextSecondaryBrush}" Text="统计加载中..." />
    </Grid>
</UserControl>
