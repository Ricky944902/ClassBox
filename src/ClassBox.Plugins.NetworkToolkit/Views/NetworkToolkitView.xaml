<UserControl x:Class="ClassBox.Plugins.NetworkToolkit.Views.NetworkToolkitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="网络工具箱" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock Text="查看本机网卡与网络参数、Ping 连通性、DNS 解析、端口占用，以及公网出口 IP。"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- 网卡信息 -->
            <TabItem Header="网卡信息">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="120" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="RefreshAdapterButton" Content="刷新网卡信息" Height="32" MinWidth="120"
                                Style="{DynamicResource FluentButtonStyle}" Click="OnRefreshAdapterClick" />
                        <Button x:Name="CopyAdapterButton" Content="复制概览" Height="32" MinWidth="96" Margin="8,0,0,0"
                                Style="{DynamicResource SubtleButtonStyle}" Click="OnCopyAdapterClick" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="8">
                        <ListBox x:Name="AdapterList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{DynamicResource FluentListBoxItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Border>

                    <Border Grid.Row="2" Style="{DynamicResource SubtleCardStyle}" Padding="10" Margin="0,8,0,0">
                        <TextBox x:Name="AdapterOverviewBox" Style="{DynamicResource FluentTextBoxStyle}"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- Ping -->
            <TabItem Header="Ping 测试">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="目标" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBox x:Name="PingHostBox" Width="240" Height="32" Style="{DynamicResource FluentTextBoxStyle}" />
                        <TextBlock Text="次数" VerticalAlignment="Center" Margin="12,0,6,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <ComboBox x:Name="PingCountBox" Width="80" Height="32" Style="{DynamicResource FluentComboBoxStyle}" />
                        <Button x:Name="PingButton" Content="开始 Ping" Height="32" MinWidth="110" Margin="12,0,0,0"
                                Style="{DynamicResource FluentButtonStyle}" Click="OnPingClick" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="8">
                        <ListBox x:Name="PingOutputList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{DynamicResource FluentListBoxItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Border>

                    <TextBlock x:Name="PingSummaryText" Grid.Row="2" Margin="2,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" Text="等待测试" />
                </Grid>
            </TabItem>

            <!-- DNS -->
            <TabItem Header="DNS 解析">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="域名 / IP" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBox x:Name="DnsQueryBox" Width="300" Height="32" Style="{DynamicResource FluentTextBoxStyle}" />
                        <Button x:Name="DnsButton" Content="解析" Height="32" MinWidth="96" Margin="12,0,0,0"
                                Style="{DynamicResource FluentButtonStyle}" Click="OnDnsClick" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="10">
                        <TextBox x:Name="DnsResultBox" Style="{DynamicResource FluentTextBoxStyle}"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- 端口 -->
            <TabItem Header="端口占用">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="端口" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBox x:Name="PortQueryBox" Width="100" Height="32" Style="{DynamicResource FluentTextBoxStyle}" />
                        <Button x:Name="PortQueryButton" Content="查询该端口" Height="32" MinWidth="110" Margin="12,0,0,0"
                                Style="{DynamicResource FluentButtonStyle}" Click="OnPortQueryClick" />
                        <Button x:Name="PortRefreshButton" Content="刷新全部监听" Height="32" MinWidth="120" Margin="8,0,0,0"
                                Style="{DynamicResource SubtleButtonStyle}" Click="OnPortRefreshClick" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="8">
                        <ListBox x:Name="PortList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{DynamicResource FluentListBoxItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Border>

                    <TextBlock x:Name="PortSummaryText" Grid.Row="2" Margin="2,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" Text="点击「刷新全部监听」加载当前 TCP 端口" />
                </Grid>
            </TabItem>

            <!-- 公网 IP -->
            <TabItem Header="公网 IP">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="PublicIpButton" Content="查询公网出口 IP" Height="32" MinWidth="150"
                                Style="{DynamicResource FluentButtonStyle}" Click="OnPublicIpClick" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="PublicIpText" TextWrapping="Wrap" FontSize="18"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" Text="尚未查询" />
                            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Text="说明：公网 IP 通过公开 HTTP 服务查询（ipify → ifconfig.me → icanhazip 依次回退）。离线、代理限制或防火墙拦截时该功能不可用，插件会给出可读提示而不会崩溃。" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource AppTextSecondaryBrush}" Text="就绪" />
    </Grid>
</UserControl>
