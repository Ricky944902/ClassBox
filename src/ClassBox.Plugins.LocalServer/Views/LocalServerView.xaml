<UserControl x:Class="ClassBox.Plugins.LocalServer.Views.LocalServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部标题与启停 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="电脑变服务器" Style="{DynamicResource SectionHeaderStyle}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock x:Name="StatusText" Text="服务未启动" FontSize="11.5" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartButton" Content="启动服务" Style="{DynamicResource AccentButtonStyle}"
                        MinWidth="96" Margin="0,0,8,0" Click="Start_Click" />
                <Button x:Name="StopButton" Content="停止服务" Style="{DynamicResource FluentButtonStyle}"
                        MinWidth="96" IsEnabled="False" Click="Stop_Click" />
            </StackPanel>
        </Grid>

        <!-- 配置卡片 -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="共享根目录" FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,12,0" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBox x:Name="RootBox" Grid.Column="1" Style="{DynamicResource FluentTextBoxStyle}"
                             IsReadOnly="True" Height="32" VerticalContentAlignment="Center"
                             Text="（尚未选择目录）" />
                    <Button Grid.Column="2" Content="选择目录" Style="{DynamicResource FluentButtonStyle}"
                            MinWidth="88" Margin="10,0,0,0" Click="Browse_Click" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="端口" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBox x:Name="PortBox" Width="84" Height="32" Text="8080"
                             Style="{DynamicResource FluentTextBoxStyle}" VerticalContentAlignment="Center" />

                    <TextBlock Text="最大并发连接" FontSize="12" VerticalAlignment="Center" Margin="20,0,8,0"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBox x:Name="ConcurrencyBox" Width="72" Height="32" Text="8"
                             Style="{DynamicResource FluentTextBoxStyle}" VerticalContentAlignment="Center" />

                    <TextBlock Text="仅监听局域网，关闭程序或点击停止即断开" FontSize="11"
                               VerticalAlignment="Center" Margin="20,0,0,0"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Row="2" CornerRadius="8" Padding="12,9"
                        Background="{DynamicResource AppLayerAltBrush}">
                    <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="11.5" LineHeight="18"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="选择要共享的目录（建议单独建一个共享文件夹，避免暴露私人文件），设置端口后点击「启动服务」，然后用手机浏览器访问下方任一地址。" />
                </Border>
            </Grid>
        </Border>

        <!-- 访问地址 -->
        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="局域网访问地址（手机与电脑需在同一网络）" FontSize="12.5"
                               VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="复制选中" Style="{DynamicResource SubtleButtonStyle}"
                                Margin="0,0,8,0" Click="CopyUrl_Click" />
                        <Button Content="浏览器打开" Style="{DynamicResource SubtleButtonStyle}"
                                Margin="0,0,8,0" Click="OpenUrl_Click" />
                        <Button Content="刷新地址" Style="{DynamicResource SubtleButtonStyle}"
                                Click="RefreshIp_Click" />
                    </StackPanel>
                </Grid>

                <ListBox x:Name="UrlList" Grid.Row="1" Height="86" Background="Transparent"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{DynamicResource FluentListBoxItemStyle}" />
            </Grid>
        </Border>

        <!-- 请求日志 -->
        <Border Grid.Row="3" Style="{DynamicResource CardStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="请求日志" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBlock x:Name="LogSummary" Text="· 共 0 次请求，当前连接 0" FontSize="11.5"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="清空日志" Style="{DynamicResource SubtleButtonStyle}"
                            Click="ClearLog_Click" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="78" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="时间" FontSize="11"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="客户端" FontSize="11"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="方法" FontSize="11"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="路径" FontSize="11"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="状态" FontSize="11"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock Grid.Column="5" Text="大小" FontSize="11"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </Grid>

                <ListBox x:Name="LogList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{DynamicResource FluentListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="78" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="11.5"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Client}" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Method}" FontSize="11.5"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Path}" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="11.5"
                                           Foreground="{DynamicResource AppSuccessBrush}" />
                                <TextBlock Grid.Column="5" Text="{Binding SizeText}" FontSize="11.5"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyLogHint" Grid.Row="2" Text="暂无请求，启动服务后用浏览器访问上方地址即可看到日志"
                           FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
