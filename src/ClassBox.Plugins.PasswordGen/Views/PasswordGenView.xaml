<UserControl x:Class="ClassBox.Plugins.PasswordGen.Views.PasswordGenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="密码生成器" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock x:Name="StatusText" Text="使用密码学安全随机数生成密码，并评估熵值与平均破解时间。"
                       FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
        </StackPanel>

        <!-- 选项 -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="16,12,16,8" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="密码长度" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,12,0" />
                    <Slider x:Name="LengthSlider" Grid.Column="1" Minimum="6" Maximum="64" Value="16"
                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            Style="{DynamicResource FluentSliderStyle}"
                            ValueChanged="LengthSlider_ValueChanged" />
                    <TextBlock x:Name="LengthText" Grid.Column="2" Text="16 位" MinWidth="46" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                </Grid>

                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <CheckBox x:Name="UpperBox" Content="大写字母 A-Z" IsChecked="True" Margin="0,0,18,8"
                              VerticalAlignment="Center" Style="{DynamicResource FluentCheckBoxStyle}"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <CheckBox x:Name="LowerBox" Content="小写字母 a-z" IsChecked="True" Margin="0,0,18,8"
                              VerticalAlignment="Center" Style="{DynamicResource FluentCheckBoxStyle}"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <CheckBox x:Name="DigitBox" Content="数字 0-9" IsChecked="True" Margin="0,0,18,8"
                              VerticalAlignment="Center" Style="{DynamicResource FluentCheckBoxStyle}"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <CheckBox x:Name="SymbolBox" Content="符号 !@#$%" Margin="0,0,18,8"
                              VerticalAlignment="Center" Style="{DynamicResource FluentCheckBoxStyle}"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <CheckBox x:Name="AmbiguousBox" Content="排除易混淆字符 0O1lI" IsChecked="True" Margin="0,0,18,8"
                              VerticalAlignment="Center" Style="{DynamicResource FluentCheckBoxStyle}"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                </WrapPanel>

                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="生成密码" Style="{DynamicResource AccentButtonStyle}" MinWidth="100" Margin="0,0,8,0"
                            Click="Generate_Click" />
                    <Button Content="批量生成 10 条" Style="{DynamicResource FluentButtonStyle}" MinWidth="122" Margin="0,0,8,0"
                            Click="Batch_Click" />
                    <Button Content="复制当前密码" Style="{DynamicResource FluentButtonStyle}" MinWidth="110"
                            Click="CopyCurrent_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 当前结果 -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="16,12,16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="当前密码" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,6" />

                    <TextBox x:Name="PasswordBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                             Style="{DynamicResource FluentTextBoxStyle}" FontFamily="Consolas" FontSize="19"
                             Padding="12,10" MinHeight="52" VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center" />

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Grid Margin="0,0,0,6">
                            <TextBlock x:Name="StrengthLabel" Text="强度" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            <TextBlock x:Name="EntropyLabel" HorizontalAlignment="Right" FontSize="11.5"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        </Grid>
                        <Border x:Name="StrengthTrack" Height="8" CornerRadius="4"
                                Background="{DynamicResource AppLayerAltBrush}" SizeChanged="StrengthTrack_SizeChanged">
                            <Border x:Name="StrengthFill" HorizontalAlignment="Left" Width="0" CornerRadius="4"
                                    Background="{DynamicResource AppSuccessBrush}" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="字符集" FontSize="11.5" Margin="0,0,12,6"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock x:Name="CharsetText" Grid.Row="0" Grid.Column="1" FontSize="11.5" Margin="0,0,0,6"
                                   TextWrapping="Wrap" Foreground="{DynamicResource AppTextPrimaryBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="破解时间" FontSize="11.5" Margin="0,0,12,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock x:Name="CrackText" Grid.Row="1" Grid.Column="1" FontSize="11.5"
                                   TextWrapping="Wrap" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </Grid>

                    <TextBlock Grid.Row="4" Text="熵值按“长度 × log2(字符集大小)”估算；破解时间按每秒 100 亿次离线爆破估算，仅供参考。"
                               FontSize="10.5" Margin="0,12,0,0" TextWrapping="Wrap" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- 生成记录 -->
            <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,12,12,6">
                        <TextBlock Text="生成记录（最近 20 条，点击即复制）" FontSize="11.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <Button Content="清空记录" HorizontalAlignment="Right" Style="{DynamicResource SubtleButtonStyle}"
                                MinWidth="80" Height="26" FontSize="11" Click="ClearHistory_Click" />
                    </Grid>
                    <ListBox x:Name="HistoryList" Grid.Row="1" Margin="8,0,8,10"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="HistoryList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="11"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Password}" FontFamily="Consolas" FontSize="12.5"
                                               Margin="8,0,8,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding EntropyText}" FontSize="10.5"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
