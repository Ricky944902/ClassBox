<UserControl x:Class="ClassBox.Plugins.UnitConverter.Views.UnitConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="单位换算" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock x:Name="StatusText" Text="覆盖长度、重量、温度、面积、体积、速度、数据存储、时间八大类，左右任一侧输入即时双向换算。"
                       FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
        </StackPanel>

        <!-- 类别 -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="换算类别" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
            <ComboBox x:Name="CategoryBox" MinWidth="150" Height="32"
                      Style="{DynamicResource FluentComboBoxStyle}"
                      SelectionChanged="CategoryBox_SelectionChanged" />
            <Button Content="复制结果" Style="{DynamicResource FluentButtonStyle}" MinWidth="90" Margin="10,0,0,0"
                    Click="CopyResult_Click" />
            <Button Content="复制对照表" Style="{DynamicResource SubtleButtonStyle}" MinWidth="104" Margin="8,0,0,0"
                    Click="CopyTable_Click" />
            <Button Content="重置" Style="{DynamicResource SubtleButtonStyle}" MinWidth="70" Margin="8,0,0,0"
                    Click="Reset_Click" />
        </WrapPanel>

        <!-- 换算区 -->
        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="18,14,18,16" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="原始数值" FontSize="11.5" Margin="0,0,0,6"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <ComboBox x:Name="FromUnitBox" Height="34" Style="{DynamicResource FluentComboBoxStyle}"
                              SelectionChanged="Unit_SelectionChanged" />
                    <TextBox x:Name="FromValueBox" Height="42" Margin="0,8,0,0" FontSize="18" FontFamily="Consolas"
                             Style="{DynamicResource FluentTextBoxStyle}" Padding="12,0" VerticalContentAlignment="Center"
                             TextChanged="FromValue_TextChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,18,14,0">
                    <Button Content="⇄" Style="{DynamicResource SubtleButtonStyle}" Width="44" Height="44" FontSize="18"
                            ToolTip="交换左右单位" Click="Swap_Click" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="换算结果" FontSize="11.5" Margin="0,0,0,6"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <ComboBox x:Name="ToUnitBox" Height="34" Style="{DynamicResource FluentComboBoxStyle}"
                              SelectionChanged="Unit_SelectionChanged" />
                    <TextBox x:Name="ToValueBox" Height="42" Margin="0,8,0,0" FontSize="18" FontFamily="Consolas"
                             Style="{DynamicResource FluentTextBoxStyle}" Padding="12,0" VerticalContentAlignment="Center"
                             TextChanged="ToValue_TextChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 对照表 -->
        <Border Grid.Row="3" Style="{DynamicResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="16,12,16,4">
                    <TextBlock x:Name="TableHeader" Text="常用换算对照表" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock x:Name="TableHint" HorizontalAlignment="Right" FontSize="11"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </Grid>
                <TextBox x:Name="TableView" Grid.Row="1" Margin="0,0,0,8" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" Padding="16,0,16,0" FontFamily="Consolas" FontSize="12.5"
                         AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
