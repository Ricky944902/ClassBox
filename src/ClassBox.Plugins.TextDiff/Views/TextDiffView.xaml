<UserControl x:Class="ClassBox.Plugins.TextDiff.Views.TextDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1.1*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="文本对比" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock x:Name="StatusText" Text="左右两栏放待比较的文本，点击“开始对比”得到行级差异。"
                       FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
        </StackPanel>

        <!-- 工具栏 -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10" Orientation="Horizontal">
            <CheckBox x:Name="IgnoreCaseBox" Content="忽略大小写" Margin="0,0,14,8" VerticalAlignment="Center"
                      Style="{DynamicResource FluentCheckBoxStyle}" />
            <CheckBox x:Name="IgnoreWhitespaceBox" Content="忽略空白差异" Margin="0,0,16,8" VerticalAlignment="Center"
                      Style="{DynamicResource FluentCheckBoxStyle}" />

            <Button Content="载入左侧文件" Style="{DynamicResource FluentButtonStyle}" MinWidth="104" Margin="0,0,8,8"
                    Click="LoadLeft_Click" />
            <Button Content="载入右侧文件" Style="{DynamicResource FluentButtonStyle}" MinWidth="104" Margin="0,0,8,8"
                    Click="LoadRight_Click" />
            <Button Content="开始对比" Style="{DynamicResource AccentButtonStyle}" MinWidth="96" Margin="0,0,8,8"
                    Click="Compare_Click" />
            <Button Content="复制结果" Style="{DynamicResource FluentButtonStyle}" MinWidth="90" Margin="0,0,8,8"
                    Click="CopyResult_Click" />
            <Button Content="清空" Style="{DynamicResource SubtleButtonStyle}" MinWidth="66" Margin="0,0,8,8"
                    Click="Clear_Click" />
            <TextBlock x:Name="StatsText" VerticalAlignment="Center" Margin="8,0,0,8" FontSize="11.5"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
        </WrapPanel>

        <!-- 输入区 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,10,14,6">
                        <TextBlock Text="左侧（原始）" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock x:Name="LeftStats" HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Grid>
                    <TextBox x:Name="LeftBox" Grid.Row="1" Style="{DynamicResource FluentTextBoxStyle}"
                             BorderThickness="0" Background="Transparent" Padding="12,0,12,10"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12.5"
                             SpellCheck.IsEnabled="False" TextChanged="Input_TextChanged" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,10,14,6">
                        <TextBlock Text="右侧（修改后）" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock x:Name="RightStats" HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Grid>
                    <TextBox x:Name="RightBox" Grid.Row="1" Style="{DynamicResource FluentTextBoxStyle}"
                             BorderThickness="0" Background="Transparent" Padding="12,0,12,10"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12.5"
                             SpellCheck.IsEnabled="False" TextChanged="Input_TextChanged" />
                </Grid>
            </Border>
        </Grid>

        <!-- 差异结果 -->
        <Border Grid.Row="3" Style="{DynamicResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,10,14,4">
                    <TextBlock Text="差异明细" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="新增" FontSize="11" Margin="0,0,4,0" Foreground="{DynamicResource AppSuccessBrush}" />
                        <TextBlock x:Name="AddedBadge" Text="0" FontSize="11" Margin="0,0,12,0"
                                   Foreground="{DynamicResource AppSuccessBrush}" />
                        <TextBlock Text="删除" FontSize="11" Margin="0,0,4,0" Foreground="{DynamicResource AppDangerBrush}" />
                        <TextBlock x:Name="RemovedBadge" Text="0" FontSize="11" Margin="0,0,12,0"
                                   Foreground="{DynamicResource AppDangerBrush}" />
                        <TextBlock Text="修改" FontSize="11" Margin="0,0,4,0" Foreground="{DynamicResource AppWarningBrush}" />
                        <TextBlock x:Name="ModifiedBadge" Text="0" FontSize="11"
                                   Foreground="{DynamicResource AppWarningBrush}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="14,4,14,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="左行号" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="左侧内容" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="右行号" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="右侧内容" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </Grid>

                <ListBox x:Name="DiffList" Grid.Row="2" Margin="8,0,8,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Rectangle Opacity="0.22" RadiusX="6" RadiusY="6">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Added">
                                                    <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                    <Setter Property="Fill" Value="{DynamicResource AppDangerBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Modified">
                                                    <Setter Property="Fill" Value="{DynamicResource AppWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>

                                <Grid Margin="4,2,4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Marker}" FontFamily="Consolas" FontSize="11.5"
                                               FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LeftNumberText}" FontFamily="Consolas" FontSize="11.5"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding LeftText}" FontFamily="Consolas" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding RightNumberText}" FontFamily="Consolas" FontSize="11.5"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="{Binding RightText}" FontFamily="Consolas" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
