<UserControl x:Class="ClassBox.Plugins.HashCheck.Views.HashCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">

    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与操作 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="文件哈希校验" Style="{DynamicResource SectionHeaderStyle}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock x:Name="StatusText" Text="就绪" FontSize="11.5" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="添加文件" Style="{DynamicResource FluentButtonStyle}" MinWidth="88"
                        Margin="0,0,8,0" Click="AddFiles_Click" />
                <Button x:Name="StartButton" Content="开始计算" Style="{DynamicResource AccentButtonStyle}"
                        MinWidth="88" Margin="0,0,8,0" Click="Start_Click" />
                <Button x:Name="CancelButton" Content="取消" Style="{DynamicResource SubtleButtonStyle}"
                        MinWidth="64" Margin="0,0,8,0" IsEnabled="False" Click="Cancel_Click" />
                <Button Content="清空" Style="{DynamicResource SubtleButtonStyle}" MinWidth="64"
                        Click="Clear_Click" />
            </StackPanel>
        </Grid>

        <!-- 进度 -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Value="0" />
                <TextBlock x:Name="ProgressText" Text="等待选择文件。可直接把文件拖到本页面。"
                           FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 文件列表 + 详情 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <!-- 文件列表 -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="待校验文件" FontSize="12.5" Margin="0,0,0,8"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />

                    <Grid Grid.Row="1" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="118" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="文件名" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="大小" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="状态" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Grid>

                    <ListBox x:Name="FileList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="FileList_SelectionChanged"
                             ItemContainerStyle="{DynamicResource FluentListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="118" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11.5"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyFileHint" Grid.Row="2"
                               Text="把文件拖到这里，或点击「添加文件」"
                               FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- 详情与比对 -->
            <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="哈希结果（选中左侧文件查看，双击值可全选复制）" FontSize="12.5"
                                   Margin="0,0,0,10" Foreground="{DynamicResource AppTextPrimaryBrush}" />

                        <TextBlock Text="MD5" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Md5Box" Grid.Column="0" Height="30" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="11.5" VerticalContentAlignment="Center"
                                     Style="{DynamicResource FluentTextBoxStyle}" />
                            <Button Grid.Column="1" Content="复制" Style="{DynamicResource SubtleButtonStyle}"
                                    Margin="8,0,0,0" Click="CopyHash_Click" Tag="MD5" />
                        </Grid>

                        <TextBlock Text="SHA1" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Sha1Box" Grid.Column="0" Height="30" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="11.5" VerticalContentAlignment="Center"
                                     Style="{DynamicResource FluentTextBoxStyle}" />
                            <Button Grid.Column="1" Content="复制" Style="{DynamicResource SubtleButtonStyle}"
                                    Margin="8,0,0,0" Click="CopyHash_Click" Tag="SHA1" />
                        </Grid>

                        <TextBlock Text="SHA256" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Sha256Box" Grid.Column="0" Height="30" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="11.5" VerticalContentAlignment="Center"
                                     Style="{DynamicResource FluentTextBoxStyle}" />
                            <Button Grid.Column="1" Content="复制" Style="{DynamicResource SubtleButtonStyle}"
                                    Margin="8,0,0,0" Click="CopyHash_Click" Tag="SHA256" />
                        </Grid>

                        <TextBlock Text="SHA512" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Sha512Box" Grid.Column="0" Height="30" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="11.5" VerticalContentAlignment="Center"
                                     Style="{DynamicResource FluentTextBoxStyle}" />
                            <Button Grid.Column="1" Content="复制" Style="{DynamicResource SubtleButtonStyle}"
                                    Margin="8,0,0,0" Click="CopyHash_Click" Tag="SHA512" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource AppLayerAltBrush}" Margin="0,0,0,12" />

                        <TextBlock Text="期望哈希（粘贴官方/发布页给出的值，长度自动识别算法）" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBox x:Name="ExpectedBox" MinHeight="52" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="11.5"
                                 Style="{DynamicResource FluentTextBoxStyle}"
                                 TextChanged="ExpectedBox_TextChanged" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="比对当前文件" Style="{DynamicResource AccentButtonStyle}"
                                    MinWidth="110" Margin="0,0,8,0" Click="Compare_Click" />
                            <Button Content="粘贴" Style="{DynamicResource SubtleButtonStyle}"
                                    MinWidth="60" Margin="0,0,8,0" Click="PasteExpected_Click" />
                            <Button Content="清空" Style="{DynamicResource SubtleButtonStyle}"
                                    MinWidth="60" Click="ClearExpected_Click" />
                        </StackPanel>

                        <Border x:Name="CompareBar" CornerRadius="8" Padding="12,10" Margin="0,12,0,0"
                                Visibility="Collapsed" Background="{DynamicResource AppLayerAltBrush}">
                            <TextBlock x:Name="CompareText" TextWrapping="Wrap" FontSize="11.5" LineHeight="18"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部统计 -->
        <Border Grid.Row="3" CornerRadius="8" Padding="14,10" Background="{DynamicResource AppLayerAltBrush}">
            <TextBlock x:Name="FooterText" TextWrapping="Wrap" FontSize="11.5"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Text="提示：哈希计算为本地只读操作，不会修改文件内容。" />
        </Border>
    </Grid>
</UserControl>
