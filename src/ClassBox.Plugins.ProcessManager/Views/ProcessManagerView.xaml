<UserControl x:Class="ClassBox.Plugins.ProcessManager.Views.ProcessManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与操作 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="进程管理" Style="{DynamicResource SectionHeaderStyle}" />
                <TextBlock Text="结束系统关键进程会危及系统稳定性，此类进程已标记为受保护"
                           FontSize="11.5" Margin="0,6,0,0"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="AutoRefreshCheck" Content="自动刷新（3 秒）" FontSize="11.5"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          Foreground="{DynamicResource AppTextPrimaryBrush}"
                          Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed" />
                <Button x:Name="RefreshButton" Content="刷新" Style="{DynamicResource FluentButtonStyle}"
                        MinWidth="80" Margin="0,0,8,0" Click="Refresh_Click" />
                <Button x:Name="KillButton" Content="结束进程" Style="{DynamicResource DangerButtonStyle}"
                        MinWidth="92" Click="Kill_Click" />
            </StackPanel>
        </Grid>

        <!-- 搜索 / 排序 / 统计 -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="0" Height="32" VerticalContentAlignment="Center"
                         Style="{DynamicResource FluentTextBoxStyle}"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="按进程名、PID、窗口标题或路径过滤" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="排序：" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <ComboBox x:Name="SortCombo" Width="150" Height="32" VerticalContentAlignment="Center"
                              SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged">
                        <ComboBoxItem Content="内存从大到小" />
                        <ComboBoxItem Content="内存从小到大" />
                        <ComboBoxItem Content="名称 A→Z" />
                        <ComboBoxItem Content="名称 Z→A" />
                        <ComboBoxItem Content="PID 从小到大" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="进程数：" FontSize="11.5"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock x:Name="CountText" Text="-" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <TextBlock Text="  内存合计：" FontSize="11.5"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock x:Name="MemoryText" Text="-" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 进程列表 + 内联确认层 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Border Style="{DynamicResource CardStyle}" Padding="8">
                <DataGrid x:Name="ProcessGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeight="30" FontSize="11.5"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent"
                          HorizontalGridLinesBrush="{DynamicResource AppLayerAltBrush}"
                          Foreground="{DynamicResource AppTextPrimaryBrush}"
                          MouseDoubleClick="ProcessGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="进程名称" Binding="{Binding Name}" Width="1.1*" />
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="76" />
                        <DataGridTextColumn Header="内存" Binding="{Binding MemoryText}" Width="96" />
                        <DataGridTextColumn Header="启动时间" Binding="{Binding StartTimeText}" Width="146" />
                        <DataGridTextColumn Header="可执行路径" Binding="{Binding Path}" Width="2*" />
                        <DataGridTextColumn Header="状态" Binding="{Binding ProtectedText}" Width="76" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 页面内确认覆盖层（不使用 MessageBox） -->
            <Border x:Name="ConfirmOverlay" Visibility="Collapsed"
                    Background="{DynamicResource AppBackgroundBrush}" Opacity="0.97"
                    CornerRadius="12" BorderThickness="1"
                    BorderBrush="{DynamicResource AppLayerAltBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="确认结束该进程？" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <TextBlock x:Name="ConfirmDetailText" Text="-" FontSize="11.5" Margin="0,10,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="18"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Content="确认结束" Style="{DynamicResource DangerButtonStyle}"
                                MinWidth="96" Margin="0,0,10,0" Click="ConfirmKill_Click" />
                        <Button Content="取消" Style="{DynamicResource SubtleButtonStyle}"
                                MinWidth="80" Click="CancelKill_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部状态 -->
        <Border Grid.Row="3" CornerRadius="8" Padding="14,10" Background="{DynamicResource AppLayerAltBrush}">
            <TextBlock x:Name="FooterText" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Text="提示：双击列表行可查看完整路径；结束进程为不可撤销操作，请确认后再执行。" />
        </Border>
    </Grid>
</UserControl>
