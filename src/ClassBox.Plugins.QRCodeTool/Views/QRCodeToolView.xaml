<UserControl x:Class="ClassBox.Plugins.QRCodeTool.Views.QRCodeToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="二维码工具" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock Text="内置手写 QR 编码器（字节模式，版本 1-10，Reed-Solomon 纠错），可生成文本、网址、WiFi 配置二维码。"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="14" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="PresetUrlButton" Content="网址" Height="30" MinWidth="64"
                                Style="{DynamicResource SubtleButtonStyle}" Click="OnPresetUrlClick" />
                        <Button x:Name="PresetTextButton" Content="纯文本" Height="30" MinWidth="64" Margin="6,0,0,0"
                                Style="{DynamicResource SubtleButtonStyle}" Click="OnPresetTextClick" />
                        <Button x:Name="PresetWifiButton" Content="WiFi 配置" Height="30" MinWidth="84" Margin="6,0,0,0"
                                Style="{DynamicResource SubtleButtonStyle}" Click="OnPresetWifiClick" />
                    </StackPanel>

                    <TextBox x:Name="InputBox" Grid.Row="1" Style="{DynamicResource FluentTextBoxStyle}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             TextChanged="OnInputChanged"
                             Text="https://www.microsoft.com" />

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="纠错等级" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox x:Name="EccBox" Height="32" Style="{DynamicResource FluentComboBoxStyle}"
                                  SelectionChanged="OnOptionChanged" />

                        <TextBlock Text="模块尺寸" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,10,0,4" />
                        <ComboBox x:Name="ModuleBox" Height="32" Style="{DynamicResource FluentComboBoxStyle}"
                                  SelectionChanged="OnOptionChanged" />

                        <Button x:Name="GenerateButton" Content="生成二维码" Height="36" Margin="0,12,0,0"
                                Style="{DynamicResource FluentButtonStyle}" Click="OnGenerateClick" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="SaveButton" Content="另存 PNG" Height="32" MinWidth="100"
                                    Style="{DynamicResource SubtleButtonStyle}" Click="OnSaveClick" />
                            <Button x:Name="CopyButton" Content="复制图片" Height="32" MinWidth="100" Margin="8,0,0,0"
                                    Style="{DynamicResource SubtleButtonStyle}" Click="OnCopyClick" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Padding="12">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <TextBlock x:Name="EmptyHint" Text="输入内容后点击「生成二维码」"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" IsHitTestVisible="False" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="2,10,0,0">
            <TextBlock x:Name="InfoText" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" Text="尚未生成" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Text="能力边界：本插件不引用第三方库，只实现二维码「生成」；从图片解码二维码需要解码库或摄像头扫码，请使用手机相机 / 系统扫码工具完成识别。" />
        </StackPanel>
    </Grid>
</UserControl>
