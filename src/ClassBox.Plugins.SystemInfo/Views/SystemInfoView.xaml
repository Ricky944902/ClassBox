<UserControl x:Class="ClassBox.Plugins.SystemInfo.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与操作 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="系统信息" Style="{DynamicResource SectionHeaderStyle}" />
                <TextBlock Text="查看操作系统、处理器、内存、磁盘、显卡与网络适配器的实时状态"
                           FontSize="11.5" Margin="0,6,0,0"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CopyButton" Content="一键复制全部信息" Style="{DynamicResource AccentButtonStyle}"
                        MinWidth="150" Margin="0,0,8,0" Click="Copy_Click" />
                <Button x:Name="RefreshButton" Content="刷新" Style="{DynamicResource FluentButtonStyle}"
                        MinWidth="80" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <StackPanel>

                <!-- 操作系统 -->
                <Border Style="{DynamicResource CardStyle}" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="操作系统" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="系统名称" FontSize="11.5" Margin="0,0,10,8"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OsNameText" Text="-" FontSize="11.5" Margin="0,0,20,8"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="版本" FontSize="11.5" Margin="0,0,10,8"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="OsVersionText" Text="-" FontSize="11.5" Margin="0,0,0,8"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="构建号" FontSize="11.5" Margin="0,0,10,8"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OsBuildText" Text="-" FontSize="11.5" Margin="0,0,20,8"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="架构" FontSize="11.5" Margin="0,0,10,8"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="OsArchText" Text="-" FontSize="11.5" Margin="0,0,0,8"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="主机名" FontSize="11.5" Margin="0,0,10,8"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MachineText" Text="-" FontSize="11.5" Margin="0,0,20,8"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="当前用户" FontSize="11.5" Margin="0,0,10,8"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="UserText" Text="-" FontSize="11.5" Margin="0,0,0,8"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="开机时长" FontSize="11.5" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="UptimeText" Text="-" FontSize="11.5"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />

                            <TextBlock Grid.Row="3" Grid.Column="2" Text="运行时" FontSize="11.5" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="3" x:Name="RuntimeText" Text="-" FontSize="11.5"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 处理器与内存 -->
                <Border Style="{DynamicResource CardStyle}" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="处理器与内存" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="处理器" FontSize="11.5" Margin="0,0,10,8"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CpuText" Text="-" FontSize="11.5" Margin="0,0,0,8"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="核心" FontSize="11.5" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CpuCoreText" Text="-" FontSize="11.5"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="物理内存" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <ProgressBar Grid.Column="1" x:Name="MemoryBar" Height="6" Minimum="0" Maximum="100"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource AppAccentBrush}"
                                         Background="{DynamicResource AppStrokeBrush}" BorderThickness="0" />
                            <TextBlock Grid.Column="2" x:Name="MemPercentText" Text="-" FontSize="11.5" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Width="52"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            <TextBlock Grid.Column="3" x:Name="MemTotalText" Text="-" FontSize="11.5" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            <TextBlock Grid.Column="4" x:Name="MemAvailText" Text="-" FontSize="11.5" Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 显卡与显示 -->
                <Border Style="{DynamicResource CardStyle}" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="显卡与显示" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="显卡" FontSize="11.5" Margin="0,0,10,8"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="GpuText" Text="-" FontSize="11.5" Margin="0,0,0,8"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="分辨率" FontSize="11.5" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ResolutionText" Text="-" FontSize="11.5"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 磁盘 -->
                <Border Style="{DynamicResource CardStyle}" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="磁盘容量" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,10" />

                        <ItemsControl x:Name="DiskList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11.5" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding UsageText}" FontSize="11.5"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                        </Grid>
                                        <ProgressBar Height="6" Minimum="0" Maximum="100"
                                                     Value="{Binding UsedPercent, Mode=OneWay}"
                                                     BorderThickness="0"
                                                     Foreground="{DynamicResource AppAccentBrush}"
                                                     Background="{DynamicResource AppStrokeBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 网络 -->
                <Border Style="{DynamicResource CardStyle}" Padding="16,14" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="网络适配器" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,10" />

                        <ItemsControl x:Name="NetList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                                            Background="{DynamicResource AppLayerAltBrush}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding TypeText}" FontSize="11.5"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            </Grid>
                                            <TextBlock Text="{Binding IpText}" FontSize="11.5" Margin="0,5,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="MAC " FontSize="11"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Mac}" FontSize="11" Margin="0,0,14,0"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                                <TextBlock Text="速率 " FontSize="11"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding SpeedText}" FontSize="11"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部状态 -->
        <Border Grid.Row="2" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
                Background="{DynamicResource AppLayerAltBrush}">
            <TextBlock x:Name="FooterText" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Text="准备采集系统信息…" />
        </Border>
    </Grid>
</UserControl>
