<UserControl x:Class="ClassBox.Plugins.MarkdownPreview.Views.MarkdownPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Markdown 预览" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock x:Name="StatusText" Text="左侧编辑，右侧实时预览（标题 / 粗斜体 / 行内代码 / 代码块 / 列表 / 引用 / 表格 / 链接）。"
                       FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10" Orientation="Horizontal">
            <Button Content="打开 .md" Style="{DynamicResource FluentButtonStyle}" MinWidth="90" Margin="0,0,8,8"
                    Click="Open_Click" />
            <Button Content="保存 .md" Style="{DynamicResource AccentButtonStyle}" MinWidth="90" Margin="0,0,8,8"
                    Click="Save_Click" />
            <Button Content="导出纯文本" Style="{DynamicResource FluentButtonStyle}" MinWidth="96" Margin="0,0,8,8"
                    Click="ExportPlain_Click" />
            <Button Content="复制 Markdown" Style="{DynamicResource FluentButtonStyle}" MinWidth="106" Margin="0,0,8,8"
                    Click="CopyMarkdown_Click" />
            <Button Content="复制纯文本" Style="{DynamicResource FluentButtonStyle}" MinWidth="96" Margin="0,0,8,8"
                    Click="CopyPlain_Click" />
            <Button Content="清空" Style="{DynamicResource SubtleButtonStyle}" MinWidth="66" Margin="0,0,8,8"
                    Click="Clear_Click" />
            <TextBlock x:Name="StatsText" VerticalAlignment="Center" Margin="8,0,0,8" FontSize="11.5"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,10,14,6">
                        <TextBlock Text="编辑（Markdown）" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock x:Name="CursorText" HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Grid>
                    <TextBox x:Name="EditorBox" Grid.Row="1" Style="{DynamicResource FluentTextBoxStyle}"
                             BorderThickness="0" Background="Transparent" Padding="12,0,12,10"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             FontFamily="Consolas" FontSize="12.5" SpellCheck.IsEnabled="False"
                             TextChanged="Editor_TextChanged" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,10,14,6">
                        <TextBlock Text="实时预览" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock x:Name="PreviewHint" HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Grid>
                    <FlowDocumentScrollViewer x:Name="PreviewViewer" Grid.Row="1" Margin="0,0,0,6"
                                              Background="Transparent" BorderThickness="0"
                                              IsToolBarVisible="False" IsSelectionEnabled="True"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
