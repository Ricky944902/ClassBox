<UserControl x:Class="ClassBox.Plugins.ScreenshotTool.Views.ScreenshotToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="截图工具" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock Text="支持全屏 / 指定屏幕抓取，在预览上拖动鼠标框选区域后裁剪，可复制到剪贴板或另存为 PNG。"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource SubtleCardStyle}" Padding="14,10,14,10" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="FullScreenButton" Content="全屏截图" MinWidth="96" Height="34"
                            Style="{DynamicResource FluentButtonStyle}" Click="OnCaptureAllClick" />
                    <ComboBox x:Name="ScreenBox" Width="230" Height="34" Margin="8,0,0,0"
                              Style="{DynamicResource FluentComboBoxStyle}"
                              DisplayMemberPath="DescribeText" />
                    <Button x:Name="CaptureScreenButton" Content="抓取该屏" MinWidth="96" Height="34" Margin="8,0,0,0"
                            Style="{DynamicResource FluentButtonStyle}" Click="OnCaptureScreenClick" />
                    <Button x:Name="DelayButton" Content="延时 3 秒" MinWidth="96" Height="34" Margin="8,0,0,0"
                            Style="{DynamicResource SubtleButtonStyle}" Click="OnDelayClick" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="CropButton" Content="裁剪选区" MinWidth="96" Height="34"
                            Style="{DynamicResource FluentButtonStyle}" Click="OnCropClick" />
                    <Button x:Name="ResetButton" Content="还原原图" MinWidth="96" Height="34" Margin="8,0,0,0"
                            Style="{DynamicResource SubtleButtonStyle}" Click="OnResetClick" />
                    <Button x:Name="CopyButton" Content="复制图片" MinWidth="96" Height="34" Margin="8,0,0,0"
                            Style="{DynamicResource SubtleButtonStyle}" Click="OnCopyClick" />
                    <Button x:Name="SaveButton" Content="另存 PNG" MinWidth="96" Height="34" Margin="8,0,0,0"
                            Style="{DynamicResource FluentButtonStyle}" Click="OnSaveClick" />
                    <Button x:Name="ChooseDirButton" Content="保存目录" MinWidth="96" Height="34" Margin="8,0,0,0"
                            Style="{DynamicResource SubtleButtonStyle}" Click="OnChooseDirClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="10">
            <Grid>
                <Grid x:Name="PreviewHost" Background="Transparent"
                      MouseLeftButtonDown="OnPreviewMouseDown"
                      MouseMove="OnPreviewMouseMove"
                      MouseLeftButtonUp="OnPreviewMouseUp"
                      SizeChanged="OnPreviewHostSizeChanged">
                    <Image x:Name="PreviewImage" Stretch="Uniform" SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Canvas x:Name="SelectionLayer" IsHitTestVisible="False" ClipToBounds="True">
                        <Rectangle x:Name="SelectionRect" Stroke="{DynamicResource AppAccentBrush}" StrokeThickness="1.5"
                                   StrokeDashArray="4 3" Fill="#332F80ED" Visibility="Collapsed" />
                    </Canvas>
                </Grid>

                <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           IsHitTestVisible="False"
                           Text="点击「全屏截图」或「抓取该屏」开始；截图后在图片上拖动可框选区域。" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="2,10,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" Text="就绪" />
            <TextBlock x:Name="InfoText" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
