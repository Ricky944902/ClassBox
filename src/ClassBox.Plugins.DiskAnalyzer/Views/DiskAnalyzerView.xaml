<UserControl x:Class="ClassBox.Plugins.DiskAnalyzer.Views.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与操作 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="磁盘空间分析" Style="{DynamicResource SectionHeaderStyle}" />
                <TextBlock Text="递归统计目录占用，找出占空间最多的文件夹与大文件"
                           FontSize="11.5" Margin="0,6,0,0"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="TopCombo" Width="112" Height="32" VerticalContentAlignment="Center"
                          SelectedIndex="1" Margin="0,0,8,0">
                    <ComboBoxItem Content="Top 10" />
                    <ComboBoxItem Content="Top 20" />
                    <ComboBoxItem Content="Top 50" />
                </ComboBox>
                <Button Content="选择目录" Style="{DynamicResource FluentButtonStyle}" MinWidth="88"
                        Margin="0,0,8,0" Click="PickFolder_Click" />
                <Button x:Name="StartButton" Content="开始分析" Style="{DynamicResource AccentButtonStyle}"
                        MinWidth="88" Margin="0,0,8,0" Click="Start_Click" />
                <Button x:Name="CancelButton" Content="取消" Style="{DynamicResource SubtleButtonStyle}"
                        MinWidth="64" IsEnabled="False" Click="Cancel_Click" />
            </StackPanel>
        </Grid>

        <!-- 路径与进度 -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="PathText" Text="尚未选择目录"
                           FontSize="11.5" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Value="0"
                             Margin="0,10,0,0" IsIndeterminate="False" />
                <TextBlock x:Name="ProgressText" Text="选择目录后点击「开始分析」，分析过程只读取文件信息，不修改任何数据。"
                           FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 结果 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 文件夹 -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="占用最大的文件夹（根目录下的一级子项）" FontSize="12.5"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="文件夹" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="大小 / 占比" FontSize="11"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Grid>

                    <ListBox x:Name="FolderList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{DynamicResource FluentListBoxItemStyle}"
                             MouseDoubleClick="FolderList_MouseDoubleClick">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="在资源管理器中打开" Click="OpenFolderLocation_Click" />
                                <MenuItem Header="复制完整路径" Click="CopyFolderPath_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11.5"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    </Grid>
                                    <ProgressBar Height="3" Margin="0,4,0,0" Maximum="100"
                                                 Value="{Binding Percent, Mode=OneWay}" />
                                    <TextBlock Text="{Binding CountText}" FontSize="10.5" Margin="0,3,0,0"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyFolderHint" Grid.Row="2" Text="暂无数据"
                               FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- 文件 -->
            <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="占用最大的文件" FontSize="12.5" Margin="0,0,0,8"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="文件名" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="大小" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Grid>

                    <ListBox x:Name="FileList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{DynamicResource FluentListBoxItemStyle}"
                             MouseDoubleClick="FileList_MouseDoubleClick">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开所在文件夹" Click="OpenFileLocation_Click" />
                                <MenuItem Header="复制完整路径" Click="CopyFilePath_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11.5"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyFileHint" Grid.Row="2" Text="暂无数据"
                               FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>

        <!-- 汇总 -->
        <Border Grid.Row="3" CornerRadius="8" Padding="14,10" Background="{DynamicResource AppLayerAltBrush}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="总大小：" FontSize="11.5"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock x:Name="TotalSizeText" Text="-" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <TextBlock Text="   文件数：" FontSize="11.5"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock x:Name="TotalFilesText" Text="-" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <TextBlock Text="   文件夹数：" FontSize="11.5"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock x:Name="TotalFoldersText" Text="-" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <TextBlock Text="   耗时：" FontSize="11.5"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock x:Name="ElapsedText" Text="-" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="FooterText" Text="提示：双击条目可在资源管理器中打开所在位置。" FontSize="11"
                           Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
