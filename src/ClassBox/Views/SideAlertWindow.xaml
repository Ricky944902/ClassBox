<Window x:Class="ClassBox.Views.SideAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Class Box 提示"
        Width="352"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Border x:Name="RootCard"
            Background="{DynamicResource AppLayerBrush}"
            BorderBrush="{DynamicResource AppStrokeBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="10"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="AccentBar" Grid.Column="0" Background="{DynamicResource AppAccentBrush}"
                    CornerRadius="12,0,0,12" />

            <Grid Grid.Column="1" Margin="16,14,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="GlyphText" Grid.Column="0" Text="&#xE7BA;"
                           FontFamily="{DynamicResource IconFontFamily}" FontSize="20"
                           Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Top"
                           Margin="0,2,12,0" />

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="TitleText" Text="提示" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" Text="" FontSize="12.5"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <Button x:Name="CloseButton" Grid.Column="2" Width="26" Height="26" Padding="0"
                        Style="{DynamicResource SubtleButtonStyle}" Click="CloseButton_Click"
                        VerticalAlignment="Top" ToolTip="关闭">
                    <TextBlock Text="&#xE711;" FontFamily="{DynamicResource IconFontFamily}" FontSize="11"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
