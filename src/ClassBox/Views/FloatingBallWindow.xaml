<Window x:Class="ClassBox.Views.FloatingBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Class Box 悬浮球"
        Width="64" Height="64"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="Root" Background="Transparent"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          MouseMove="Root_MouseMove"
          MouseLeftButtonUp="Root_MouseLeftButtonUp"
          MouseRightButtonUp="Root_MouseRightButtonUp">

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="显示主界面" Click="ShowMain_Click" />
                <MenuItem Header="退出 Class Box" Click="Exit_Click" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Ellipse x:Name="BallBody" Margin="6">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.32,0.28" Center="0.5,0.5" RadiusX="0.78" RadiusY="0.78">
                    <GradientStop Color="#FF5B9BFF" Offset="0.0" />
                    <GradientStop Color="#FF2F6BE0" Offset="0.62" />
                    <GradientStop Color="#FF1E4CB0" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.42" Color="#000000" Direction="270" />
            </Ellipse.Effect>
        </Ellipse>

        <TextBlock Text="&#xE7B8;"
                   FontFamily="{DynamicResource IconFontFamily}" FontSize="20"
                   Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False" />
    </Grid>
</Window>
