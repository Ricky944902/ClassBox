<UserControl x:Class="ClassBox.Views.Pages.PluginManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="插件中心" Style="{DynamicResource SectionHeaderStyle}" />
                <TextBlock Text="{Binding PluginsDirectory}" FontSize="11.5" Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
                <TextBlock Text="{Binding HiddenPluginSummary}" FontSize="11.5" Margin="0,4,0,0"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{DynamicResource SubtleCardStyle}" Padding="12,7" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{DynamicResource SwitchToggleStyle}"
                                      IsChecked="{Binding ShowHiddenPlugins, Mode=TwoWay}"
                                      ToolTip="开启后显示全部插件，关闭后仅显示 4 个核心插件"
                                      VerticalAlignment="Center" />
                        <TextBlock Text="显示隐藏内容" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Button Content="打开插件目录" Style="{DynamicResource FluentButtonStyle}"
                        Command="{Binding OpenPluginsFolderCommand}" Margin="0,0,8,0" />
                <Button Content="检查更新" Style="{DynamicResource AccentButtonStyle}"
                        Command="{Binding RefreshPluginsCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Plugins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11"
                                        Background="{DynamicResource AppLayerAltBrush}" Margin="0,0,16,0"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Metadata.Glyph}" FontFamily="{DynamicResource IconFontFamily}"
                                               FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppAccentBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Metadata.Name}" FontSize="14.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        <Border Background="{DynamicResource AppLayerAltBrush}" CornerRadius="6"
                                                Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Metadata.Version}" FontSize="10.5"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                        </Border>
                                        <Border Background="{DynamicResource AppLayerAltBrush}" CornerRadius="6"
                                                Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Metadata.Category}" FontSize="10.5"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Metadata.Description}" FontSize="12" Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="状态：" FontSize="11.5"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Error}" FontSize="11.5" Margin="10,0,0,0"
                                                   Foreground="{DynamicResource AppDangerBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2" VerticalAlignment="Center" MinWidth="76"
                                        Style="{DynamicResource FluentButtonStyle}"
                                        Command="{Binding DataContext.TogglePluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock FontSize="12.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="启用" />
                                                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="Text" Value="停用" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
