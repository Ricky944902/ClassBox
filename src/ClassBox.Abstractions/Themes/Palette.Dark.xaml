<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fluent 深色语义色板 -->
    <Color x:Key="AppBackgroundColor">#1F1F1F</Color>
    <Color x:Key="AppLayerColor">#2B2B2B</Color>
    <Color x:Key="AppLayerAltColor">#323232</Color>
    <Color x:Key="AppStrokeColor">#3D3D3D</Color>
    <Color x:Key="AppTextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="AppTextSecondaryColor">#ADADAD</Color>
    <Color x:Key="AppAccentColor">#4CC2FF</Color>
    <Color x:Key="AppAccentHoverColor">#6FCCFF</Color>
    <Color x:Key="AppAccentForegroundColor">#00243D</Color>
    <Color x:Key="AppDangerColor">#FF99A4</Color>
    <Color x:Key="AppSuccessColor">#6CCB5F</Color>
    <Color x:Key="AppWarningColor">#FCE100</Color>
    <Color x:Key="AppHoverColor">#FFFFFF14</Color>
    <Color x:Key="AppSelectedColor">#4CC2FF26</Color>
    <Color x:Key="AppCardShadowColor">#55000000</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppLayerBrush" Color="{StaticResource AppLayerColor}" />
    <SolidColorBrush x:Key="AppLayerAltBrush" Color="{StaticResource AppLayerAltColor}" />
    <SolidColorBrush x:Key="AppStrokeBrush" Color="{StaticResource AppStrokeColor}" />
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource AppAccentHoverColor}" />
    <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="{StaticResource AppAccentForegroundColor}" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource AppDangerColor}" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource AppWarningColor}" />
    <SolidColorBrush x:Key="AppHoverBrush" Color="{StaticResource AppHoverColor}" />
    <SolidColorBrush x:Key="AppSelectedBrush" Color="{StaticResource AppSelectedColor}" />

</ResourceDictionary>
