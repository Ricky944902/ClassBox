<UserControl x:Class="ClassBox.Plugins.EncodeTool.Views.EncodeToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="编码转换台" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock x:Name="StatusText" Text="选择编码方式与方向，左侧输入即时在右侧得到结果。"
                       FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10" Orientation="Horizontal">
            <TextBlock Text="编码方式" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
            <ComboBox x:Name="ModeBox" Width="168" Height="32" Margin="0,0,16,0"
                      Style="{DynamicResource FluentComboBoxStyle}" SelectionChanged="ModeBox_SelectionChanged" />

            <RadioButton x:Name="EncodeRadio" Content="编码" GroupName="Direction" Margin="0,0,14,0"
                         VerticalAlignment="Center" Style="{DynamicResource FluentRadioButtonStyle}"
                         IsChecked="True" Checked="Direction_Changed" />
            <RadioButton x:Name="DecodeRadio" Content="解码" GroupName="Direction" Margin="0,0,18,0"
                         VerticalAlignment="Center" Style="{DynamicResource FluentRadioButtonStyle}"
                         Checked="Direction_Changed" />

            <Button Content="载入文件" Style="{DynamicResource FluentButtonStyle}" MinWidth="90" Margin="0,0,8,8"
                    Click="LoadFile_Click" />
            <Button Content="结果存为文件" Style="{DynamicResource FluentButtonStyle}" MinWidth="112" Margin="0,0,8,8"
                    Click="SaveResult_Click" />
            <Button Content="交换" Style="{DynamicResource SubtleButtonStyle}" MinWidth="66" Margin="0,0,8,8"
                    Click="Swap_Click" />
            <Button Content="复制结果" Style="{DynamicResource AccentButtonStyle}" MinWidth="90" Margin="0,0,8,8"
                    Click="CopyResult_Click" />
            <Button Content="清空" Style="{DynamicResource SubtleButtonStyle}" MinWidth="66" Margin="0,0,8,8"
                    Click="Clear_Click" />
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,10,14,6">
                        <TextBlock Text="输入" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock x:Name="InputStats" HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Grid>
                    <TextBox x:Name="InputBox" Grid.Row="1" Style="{DynamicResource FluentTextBoxStyle}"
                             BorderThickness="0" Background="Transparent" Padding="12,0,12,10"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             FontFamily="Consolas" FontSize="12.5" SpellCheck.IsEnabled="False"
                             TextChanged="InputBox_TextChanged" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,10,14,6">
                        <TextBlock Text="输出（只读）" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock x:Name="OutputStats" HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Grid>
                    <TextBox x:Name="OutputBox" Grid.Row="1" Style="{DynamicResource FluentTextBoxStyle}"
                             BorderThickness="0" Background="Transparent" Padding="12,0,12,10"
                             AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             FontFamily="Consolas" FontSize="12.5" SpellCheck.IsEnabled="False" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="HintText" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   Text="Base64 / Hex 可直接解码为文件字节；HTML 实体支持命名实体与 &amp;#xxxx; 数字实体。" />
    </Grid>
</UserControl>
