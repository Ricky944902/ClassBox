<UserControl x:Class="ClassBox.Plugins.ClipboardHistory.Views.ClipboardHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="剪贴板历史" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock Text="后台监听系统剪贴板文本，最近 100 条自动去重；收藏项始终置顶。"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource SubtleCardStyle}" Padding="14,10,14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PauseButton" Grid.Column="0" Content="暂停监听" MinWidth="96" Height="34"
                        Style="{DynamicResource FluentButtonStyle}" Click="OnPauseToggleClick" />
                <Button x:Name="ClearAllButton" Grid.Column="1" Content="清除全部" MinWidth="88" Height="34"
                        Margin="8,0,0,0" Style="{DynamicResource DangerButtonStyle}" Click="OnClearAllClick" />
                <Button x:Name="ClearUnpinnedButton" Grid.Column="2" Content="清除未收藏" MinWidth="100" Height="34"
                        Margin="8,0,0,0" Style="{DynamicResource SubtleButtonStyle}" Click="OnClearUnfavoriteClick" />

                <TextBox x:Name="SearchBox" Grid.Column="3" Height="34" Margin="8,0,0,0"
                         Style="{DynamicResource FluentTextBoxStyle}" Padding="12,0"
                         VerticalContentAlignment="Center"
                         TextChanged="OnSearchChanged"
                         ToolTip="搜索历史文本内容" />

                <TextBlock x:Name="CountText" Grid.Column="4" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" Text="0 条" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="8">
            <Grid>
                <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{DynamicResource FluentListBoxItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource AppLayerBrush}" CornerRadius="8"
                                    Padding="12,9,12,9" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding FavoriteMark}" FontSize="15"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{DynamicResource AppAccentBrush}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Summary}" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding TimeText}" FontSize="11"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="{Binding LengthText}" FontSize="11" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="{Binding FavoriteText}" FontSize="11" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="回填" Width="56" Height="28" Margin="6,0,0,0"
                                                Style="{DynamicResource SubtleButtonStyle}"
                                                Click="OnCopyBackClick" />
                                        <Button Content="收藏" Width="56" Height="28" Margin="6,0,0,0"
                                                Style="{DynamicResource SubtleButtonStyle}"
                                                Click="OnFavoriteClick" />
                                        <Button Content="删除" Width="56" Height="28" Margin="6,0,0,0"
                                                Style="{DynamicResource SubtleButtonStyle}"
                                                Click="OnDeleteEntryClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyHint" Text="暂无剪贴板记录，复制一段文字后会自动出现在这里。"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           IsHitTestVisible="False" Visibility="Collapsed" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource AppTextSecondaryBrush}" Text="监听中…" />
    </Grid>
</UserControl>
