<UserControl x:Class="ClassBox.Plugins.JsonTool.Views.JsonToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与状态 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="JSON 工具" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock x:Name="StatusText" Text="把 JSON 粘贴到左侧，再点上方任一功能按钮，结果输出到右侧。"
                       FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
        </StackPanel>

        <!-- 工具栏 -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10" Orientation="Horizontal">
            <TextBlock Text="缩进" VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" />
            <ComboBox x:Name="IndentBox" Width="96" Height="32" Margin="0,0,12,0"
                      Style="{DynamicResource FluentComboBoxStyle}" />

            <TextBlock Text="类名" VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" />
            <TextBox x:Name="ClassNameBox" Width="130" Height="32" Margin="0,0,12,0" Text="RootObject"
                     Style="{DynamicResource FluentTextBoxStyle}" VerticalContentAlignment="Center" />

            <Button Content="格式化" Style="{DynamicResource AccentButtonStyle}" MinWidth="76" Margin="0,0,8,8"
                    Click="Format_Click" />
            <Button Content="压缩" Style="{DynamicResource FluentButtonStyle}" MinWidth="66" Margin="0,0,8,8"
                    Click="Compress_Click" />
            <Button Content="校验" Style="{DynamicResource FluentButtonStyle}" MinWidth="66" Margin="0,0,8,8"
                    Click="Validate_Click" />
            <Button Content="键排序" Style="{DynamicResource FluentButtonStyle}" MinWidth="72" Margin="0,0,8,8"
                    Click="Sort_Click" />
            <Button Content="转义" Style="{DynamicResource FluentButtonStyle}" MinWidth="66" Margin="0,0,8,8"
                    Click="Escape_Click" />
            <Button Content="反转义" Style="{DynamicResource FluentButtonStyle}" MinWidth="72" Margin="0,0,8,8"
                    Click="Unescape_Click" />
            <Button Content="生成 C# 类" Style="{DynamicResource FluentButtonStyle}" MinWidth="96" Margin="0,0,8,8"
                    Click="ToCSharp_Click" />
        </WrapPanel>

        <!-- 左右双栏 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,10,14,6">
                        <TextBlock Text="输入" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock x:Name="InputStats" HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Grid>
                    <TextBox x:Name="InputBox" Grid.Row="1" Style="{DynamicResource FluentTextBoxStyle}"
                             BorderThickness="0" Background="Transparent" Padding="12,0,12,10"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12.5"
                             SpellCheck.IsEnabled="False" TextChanged="InputBox_TextChanged" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,10,14,6">
                        <TextBlock Text="输出（只读）" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock x:Name="OutputStats" HorizontalAlignment="Right" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Grid>
                    <TextBox x:Name="OutputBox" Grid.Row="1" Style="{DynamicResource FluentTextBoxStyle}"
                             BorderThickness="0" Background="Transparent" Padding="12,0,12,10"
                             AcceptsReturn="True" TextWrapping="NoWrap" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12.5"
                             SpellCheck.IsEnabled="False" />
                </Grid>
            </Border>
        </Grid>

        <!-- 底部操作 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="复制输出" Style="{DynamicResource FluentButtonStyle}" MinWidth="90" Margin="0,0,8,0"
                    Click="CopyOutput_Click" />
            <Button Content="复制输入" Style="{DynamicResource SubtleButtonStyle}" MinWidth="90" Margin="0,0,8,0"
                    Click="CopyInput_Click" />
            <Button Content="输出回填输入" Style="{DynamicResource SubtleButtonStyle}" MinWidth="110" Margin="0,0,8,0"
                    Click="Swap_Click" />
            <Button Content="清空" Style="{DynamicResource SubtleButtonStyle}" MinWidth="70"
                    Click="Clear_Click" />
        </StackPanel>
    </Grid>
</UserControl>
