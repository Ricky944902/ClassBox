<UserControl x:Class="ClassBox.Plugins.PresenceMonitor.Views.PresenceMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,4,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 状态总览 -->
            <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatusText}" Style="{DynamicResource SubtitleTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DetailText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock Text="{Binding DeviceText}" FontSize="11.5" Margin="0,6,0,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <TextBlock Text="{Binding MetricsText}" FontSize="11.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="开始监测" Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding StartCommand}" Margin="0,0,0,8" MinWidth="120" />
                        <Button Content="暂停监测" Style="{DynamicResource FluentButtonStyle}"
                                Command="{Binding StopCommand}" Margin="0,0,0,8" MinWidth="120" />
                        <Button Content="单次测试" Style="{DynamicResource SubtleButtonStyle}"
                                Command="{Binding TestCommand}" MinWidth="120" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 参数设置 -->
                <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="检测与触发设置" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,16" />

                        <TextBlock Text="触发动作" FontSize="12" Margin="0,0,0,6"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <ComboBox Style="{DynamicResource FluentComboBoxStyle}" Margin="0,0,0,12"
                                  ItemsSource="{Binding ActionOptions}"
                                  SelectedIndex="{Binding ActionIndex, Mode=TwoWay}" />

                        <StackPanel Margin="0,0,0,12"
                                    Visibility="{Binding NeedsTargetProcess, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="需要保留的进程（触发时其它窗口最小化）" FontSize="12" Margin="0,0,0,6"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <ComboBox Style="{DynamicResource FluentComboBoxStyle}" IsEditable="True"
                                      ItemsSource="{Binding ProcessNames}"
                                      Text="{Binding TargetProcess, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="检测灵敏度" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                                       Text="{Binding Sensitivity, StringFormat={}{0:P0}}"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </Grid>
                        <Slider Style="{DynamicResource FluentSliderStyle}" Minimum="0" Maximum="1"
                                SmallChange="0.05" LargeChange="0.1" Margin="0,0,0,12"
                                Value="{Binding Sensitivity, Mode=TwoWay}" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="抓帧间隔（秒）" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                                       Text="{Binding IntervalSeconds, StringFormat={}{0:0.0} s}"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </Grid>
                        <Slider Style="{DynamicResource FluentSliderStyle}" Minimum="0.5" Maximum="10"
                                SmallChange="0.5" LargeChange="1" Margin="0,0,0,12"
                                Value="{Binding IntervalSeconds, Mode=TwoWay}" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="持续确认时长（秒）" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                                       Text="{Binding PresenceSeconds, StringFormat={}{0:0.0} s}"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </Grid>
                        <Slider Style="{DynamicResource FluentSliderStyle}" Minimum="0.5" Maximum="10"
                                SmallChange="0.5" LargeChange="1" Margin="0,0,0,12"
                                Value="{Binding PresenceSeconds, Mode=TwoWay}" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="提示冷却（秒）" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                                       Text="{Binding CooldownSeconds, StringFormat={}{0:0} s}"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </Grid>
                        <Slider Style="{DynamicResource FluentSliderStyle}" Minimum="0" Maximum="600"
                                SmallChange="10" LargeChange="30" Margin="0,0,0,14"
                                Value="{Binding CooldownSeconds, Mode=TwoWay}" />

                        <CheckBox Content="应用启动后自动开始监测" Style="{DynamicResource FluentCheckBoxStyle}"
                                  IsChecked="{Binding StartOnLaunch, Mode=TwoWay}" Margin="0,0,0,10" />

                        <TextBlock Text="摄像头设备" FontSize="12" Margin="0,4,0,6"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        <ComboBox Style="{DynamicResource FluentComboBoxStyle}"
                                  ItemsSource="{Binding DeviceOptions}"
                                  SelectedIndex="{Binding DeviceIndex, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- 事件记录 -->
                <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="检测事件" Style="{DynamicResource SectionHeaderStyle}" />
                            <Button Content="清空" HorizontalAlignment="Right"
                                    Style="{DynamicResource SubtleButtonStyle}"
                                    Command="{Binding ResetCommand}" />
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding RecentEvents}"
                                 ItemContainerStyle="{DynamicResource FluentListBoxItemStyle}"
                                 Background="Transparent" BorderThickness="0"
                                 Height="320">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{DynamicResource SubtleCardStyle}">
                <StackPanel>
                    <TextBlock Text="使用说明" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,8" />
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" LineHeight="19"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="1. 本插件仅在本机分析摄像头画面，不保存、不上传任何图像。&#x0a;2. 检测基于肤色区域统计，光线不足或背景大面积接近肤色时可能误判，可调整灵敏度。&#x0a;3. 提示为屏幕侧边非模态气泡，不会抢走当前焦点，可等待自动关闭。&#x0a;4. 触发动作可选「仅提示」「最小化所有窗口」「只保留指定进程」，选择后立即生效并写入配置。" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
