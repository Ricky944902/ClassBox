<UserControl x:Class="ClassBox.Plugins.WindowTopmost.Views.WindowTopmostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClassBox.Plugins.WindowTopmost"
             Background="Transparent">

    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具条 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="窗口置顶与嵌入" Style="{DynamicResource SectionHeaderStyle}" />
                <TextBlock Text="{Binding PinnedSummary}" FontSize="11.5" Margin="0,6,0,0"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Width="200" Style="{DynamicResource FluentTextBoxStyle}" Margin="0,0,10,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="按标题或进程名搜索" />
                <Button Content="刷新" Style="{DynamicResource FluentButtonStyle}" Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}" />
                <Button Content="全部取消置顶" Style="{DynamicResource SubtleButtonStyle}"
                        Command="{Binding ClearAllTopmostCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 窗口列表 -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="8">
                <ListBox ItemsSource="{Binding WindowsView}"
                         SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                         ItemContainerStyle="{DynamicResource FluentListBoxItemStyle}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" Width="18" Height="18" Margin="0,0,10,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Icon}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding ProcessName}" FontSize="10.5" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 详情与嵌入区 -->
            <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 选中窗口信息 -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding SelectedWindow.DisplayName, FallbackValue=未选择窗口}"
                                   FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBlock FontSize="11.5" Margin="0,6,0,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}">
                            <Run Text="进程：" />
                            <Run Text="{Binding SelectedWindow.ProcessName, Mode=OneWay}" />
                            <Run Text="  PID：" />
                            <Run Text="{Binding SelectedWindow.ProcessId, Mode=OneWay}" />
                            <Run Text="  句柄：" />
                            <Run Text="{Binding SelectedWindow.HandleText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Row="1" Margin="0,14,0,12">
                        <WrapPanel>
                            <Button Content="{Binding TopmostButtonText}" Style="{DynamicResource AccentButtonStyle}"
                                    Command="{Binding ToggleTopmostCommand}" Margin="0,0,8,8" />
                            <Button Content="嵌入到此处" Style="{DynamicResource FluentButtonStyle}"
                                    IsEnabled="{Binding HasSelection}" Click="Embed_Click" Margin="0,0,8,8" />
                            <Button Content="解除嵌入" Style="{DynamicResource FluentButtonStyle}"
                                    Command="{Binding DetachCommand}" Margin="0,0,8,8" />
                            <Button Content="最小化" Style="{DynamicResource SubtleButtonStyle}"
                                    Command="{Binding MinimizeCommand}" Margin="0,0,8,8" />
                            <Button Content="还原" Style="{DynamicResource SubtleButtonStyle}"
                                    Command="{Binding RestoreCommand}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Text="{Binding EmbedHint}" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </StackPanel>

                    <!-- 嵌入容器（原生子窗口区域，WPF 元素无法覆盖其上） -->
                    <Border Grid.Row="2" CornerRadius="10" BorderThickness="1"
                            BorderBrush="{DynamicResource AppStrokeBrush}"
                            Background="{DynamicResource AppLayerAltBrush}"
                            ClipToBounds="True">
                        <local:EmbedHost x:Name="EmbedContainer" Visibility="Collapsed" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
