<UserControl x:Class="ClassBox.Plugins.NotesPad.Views.NotesPadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="速记便笺" Style="{DynamicResource SectionHeaderStyle}" />
            <TextBlock Text="输入即自动保存到插件数据目录；置顶便笺始终排在最前。"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：便笺列表 -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="12,12,12,12" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button x:Name="NewNoteButton" Content="新建便笺" MinWidth="92" Height="32"
                                Style="{DynamicResource FluentButtonStyle}" Click="OnNewNoteClick" />
                        <Button x:Name="DeleteNoteButton" Content="删除" MinWidth="64" Height="32" Margin="8,0,0,0"
                                Style="{DynamicResource DangerButtonStyle}" Click="OnDeleteNoteClick" />
                    </StackPanel>

                    <TextBox x:Name="SearchBox" Grid.Row="1" Height="32" Margin="0,10,0,10"
                             Style="{DynamicResource FluentTextBoxStyle}" Padding="10,0"
                             VerticalContentAlignment="Center"
                             TextChanged="OnSearchChanged"
                             ToolTip="按标题或正文搜索便笺" />

                    <ListBox x:Name="NoteList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{DynamicResource FluentListBoxItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnNoteSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="6,6,6,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PinText}" FontSize="10" Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppAccentBrush}" />
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Preview}" FontSize="11" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                        <TextBlock Text="{Binding UpdatedText}" FontSize="10" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyHint" Grid.Row="2" Text="暂无便笺，点击「新建便笺」开始。"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- 右侧：编辑器 -->
            <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Padding="14,12,14,12">
                <Grid x:Name="EditorPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TitleBox" Grid.Column="0" Height="34"
                                 Style="{DynamicResource FluentTextBoxStyle}" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="OnTitleChanged"
                                 ToolTip="便笺标题（等同于重命名）" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <CheckBox x:Name="PinCheck" Content="置顶" VerticalAlignment="Center"
                                      Style="{DynamicResource FluentCheckBoxStyle}"
                                      Click="OnPinClick" />
                            <Button x:Name="RenameButton" Content="重命名" MinWidth="74" Height="32" Margin="10,0,0,0"
                                    Style="{DynamicResource SubtleButtonStyle}" Click="OnRenameClick" />
                            <Button x:Name="ExportButton" Content="导出 txt" MinWidth="80" Height="32" Margin="8,0,0,0"
                                    Style="{DynamicResource SubtleButtonStyle}" Click="OnExportClick" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="EditorHint" Grid.Row="1" Margin="2,8,0,6" FontSize="11"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="选择左侧便笺开始编辑，正文自动保存。" />

                    <TextBox x:Name="ContentBox" Grid.Row="2"
                             Style="{DynamicResource FluentTextBoxStyle}"
                             Padding="10,8,10,8"
                             AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="OnContentChanged" />

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,8,0,0">
                        <TextBlock x:Name="CharCountText"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" Text="字数 0" />
                        <TextBlock x:Name="SaveStateText" Margin="16,0,0,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" Text="尚未修改" />
                        <TextBlock x:Name="PathText" Margin="16,0,0,0" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" Text="" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" Text="就绪" />
            <Button x:Name="UndoDeleteButton" Content="撤销删除" Height="26" MinWidth="78" Margin="12,0,0,0"
                    Style="{DynamicResource SubtleButtonStyle}" Visibility="Collapsed"
                    Click="OnUndoDeleteClick" />
        </StackPanel>
    </Grid>
</UserControl>
